{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP}"
    },
    "foundryAccountName": {
      "value": "${IRONTRAIL_FOUNDRY_ACCOUNT_NAME}"
    },
    "modelDeploymentName": {
      "value": "${IRONTRAIL_AZURE_OPENAI_DEPLOYMENT}"
    },
    "reviewDeploymentName": {
      "value": "${IRONTRAIL_AI_REVIEW_DEPLOYMENT=}"
    },
    "chatDeploymentName": {
      "value": "${IRONTRAIL_AI_CHAT_DEPLOYMENT=}"
    },
    "aiMaxRetries": {
      "value": "${IRONTRAIL_AI_MAX_RETRIES=2}"
    },
    "aadClientId": {
      "value": "${IRONTRAIL_AAD_CLIENT_ID}"
    },
    "aadClientSecret": {
      "value": "${IRONTRAIL_AAD_CLIENT_SECRET}"
    },
    "bootstrapInviteHash": {
      "value": "${IRONTRAIL_BOOTSTRAP_INVITE_HASH}"
    },
    "betaRevealSeed": {
      "value": "${IRONTRAIL_BETA_REVEAL_SEED}"
    },
    "ownerObjectId": {
      "value": "${IRONTRAIL_OWNER_OBJECT_ID}"
    },
    "authReady": {
      "value": "${IRONTRAIL_AUTH_READY}"
    },
    "googleAuthEnabled": {
      "value": "${IRONTRAIL_GOOGLE_AUTH_ENABLED}"
    },
    "stageC2PatchMode": {
      "value": "${IRONTRAIL_STAGE_C2_PATCH_MODE}"
    },
    "grantOwnerKeyVaultAccess": {
      "value": "${IRONTRAIL_GRANT_OWNER_KV_ACCESS=false}"
    },
    "grantOwnerStorageDiagnosticAccess": {
      "value": "${IRONTRAIL_GRANT_OWNER_STORAGE_DIAGNOSTIC_ACCESS=false}"
    },
    "googleClientId": {
      "value": "${IRONTRAIL_GOOGLE_CLIENT_ID}"
    },
    "googleClientSecret": {
      "value": "${IRONTRAIL_GOOGLE_CLIENT_SECRET}"
    },
    "maxUsers": {
      "value": "${IRONTRAIL_MAX_USERS}"
    },
    "currentContainerImage": {
      "value": "${SERVICE_WEB_IMAGE_NAME}"
    },
    "currentWebUrl": {
      "value": "${WEB_URL}"
    },
    "monthlyBudgetEur": {
      "value": 25
    }
  }
}
